#!/usr/bin/env node
import { execFileSync } from 'node:child_process';
import { readFileSync, writeFileSync } from 'node:fs';
import path from 'node:path';

const OLLAMA_URL = 'http://localhost:11434/api/generate';
const MODEL = 'qwen2.5-coder:7b';
const TIMEOUT_MS = 30_000;
const TOKEN_LIMIT = 4000;
const CHARS_PER_TOKEN = 4;
const MAX_BUFFER = 1024 * 1024 * 20;

const [, , msgFile, source] = process.argv;

const SKIP_SOURCES = new Set(['message', 'merge', 'squash', 'commit']);
if (source && SKIP_SOURCES.has(source)) {
  process.exit(0);
}

function git(args) {
  return execFileSync('git', args, { maxBuffer: MAX_BUFFER }).toString();
}

const diff = git(['diff', '--cached']);
if (!diff.trim()) {
  process.exit(0);
}

// ponytail: naive regex signature scan, misses/false-positives on unusual
// syntax — upgrade to a real diff-AST parser if this proves noisy
function buildDiffSection() {
  if (diff.length <= TOKEN_LIMIT * CHARS_PER_TOKEN) return diff;

  const stat = git(['diff', '--cached', '--stat']);
  const files = git(['diff', '--cached', '--name-only']).split('\n').filter(Boolean);

  const sigPattern =
    /^[+-].*\b(function|class|def|interface|async\s+function|public|private|protected)\b.*[({]/;
  const signatures = [];
  for (const file of files) {
    const fileDiff = git(['diff', '--cached', '-U0', '--', file]);
    for (const line of fileDiff.split('\n')) {
      if (sigPattern.test(line)) signatures.push(`${file}: ${line.trim()}`);
    }
  }

  return `${stat}\n\n--- 함수/클래스 시그니처 변경 ---\n${signatures.join('\n')}`;
}

function loadSystemPrompt() {
  const skillPath = path.join(process.cwd(), '.claude/skills/git-workflow/SKILL.md');
  const raw = readFileSync(skillPath, 'utf8');
  const body = raw.replace(/^---\n[\s\S]*?\n---\n/, '').trim();
  return `${body}\n\n위 규칙에 맞는 커밋 메시지만 출력하세요. 설명, 마크다운 코드블록, 따옴표 없이 메시지 텍스트만 작성하세요.`;
}

async function generateMessage() {
  const system = loadSystemPrompt();
  const prompt = `다음은 staged된 git diff입니다:\n\n${buildDiffSection()}`;

  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), TIMEOUT_MS);

  try {
    const res = await fetch(OLLAMA_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ model: MODEL, system, prompt, stream: false }),
      signal: controller.signal,
    });
    if (!res.ok) throw new Error(`Ollama HTTP ${res.status}`);
    const data = await res.json();
    return data.response?.trim();
  } finally {
    clearTimeout(timeout);
  }
}

try {
  const message = await generateMessage();
  if (message) writeFileSync(msgFile, `${message}\n`);
} catch (err) {
  console.error(`[prepare-commit-msg] Ollama 커밋 메시지 생성 실패: ${err.message}`);
}
